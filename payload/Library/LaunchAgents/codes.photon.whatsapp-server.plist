<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>codes.photon.whatsapp-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/prism</string>
        <string>run</string>
        <string>--silent</string>
        <string>--if-user</string>
        <string>--gui</string>
        <string>--astrolabe</string>
        <string>--idempotent</string>
        <string>--condition</string>
        <string>%(WHATSAPP) &amp;&amp; %(HELPER)</string>
        <string>--</string>
        <string>/usr/local/bin/whatsapp-server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/var/log/whatsapp-server.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/whatsapp-server.log</string>
</dict>
</plist>
